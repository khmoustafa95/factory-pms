# Environment templates (Vite loads by --mode):
#
#   local       → .env.development          npm run dev:local
#   staging     → .env.staging (+ .local)   npm run dev:staging | build:staging
#   production  → .env.production (+ .local) npm run build
#
# Secrets: copy the matching file to .env.<mode>.local (gitignored).

VITE_APP_ENV=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
